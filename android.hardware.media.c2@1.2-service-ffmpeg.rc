service vendor.media.c2.ffmpeg /vendor/bin/hw/android.hardware.media.c2@1.2-service-ffmpeg
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh
