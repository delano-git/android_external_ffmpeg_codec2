cc_binary {
    name: "android.hardware.media.c2@1.2-service-ffmpeg",
    relative_install_path: "hw",
    vendor: true,
    defaults: ["libcodec2-hidl-defaults"],
    srcs: [
        "C2FFMPEGAudioDecodeComponent.cpp",
        "C2FFMPEGAudioDecodeInterface.cpp",
        "C2FFMPEGComponentInterface.cpp",
        "C2FFMPEGComponentStore.cpp",
        "C2FFMPEGVideoDecodeComponent.cpp",
        "C2FFMPEGVideoDecodeInterface.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "android.hardware.graphics.common@1.0",
        "libavcodec",
        "libavservices_minijail",
        "libavutil",
        "libbase",
        "libbinder",
        "libcodec2_soft_common",
        "libffmpeg_utils",
        "liblog",
        "libstagefright_foundation",
        "libswresample",
        "libswscale",
        "libutils",
    ],
    init_rc: ["android.hardware.media.c2@1.2-service-ffmpeg.rc"],
    vintf_fragments: ["android.hardware.media.c2@1.2-service-ffmpeg.xml"],
    required: [
        "android.hardware.media.c2-default-seccomp_policy",
        "android.hardware.media.c2-ffmpeg-extended-seccomp_policy",
    ],
}

prebuilt_etc {
    name: "android.hardware.media.c2-ffmpeg-extended-seccomp_policy",
    src: "android.hardware.media.c2-ffmpeg-extended-seccomp_policy",
    sub_dir: "seccomp_policy",
    vendor: true,
}
